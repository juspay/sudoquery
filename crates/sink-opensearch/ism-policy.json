{
  "policy": {
    "description": "Rolls each events-* data stream over daily or at 30gb per primary shard, and deletes a backing index 7 days after it rolled over. Local values: Terraform owns the policy in deployed clusters.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_index_age": "1d",
              "min_primary_shard_size": "30gb"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_rollover_age": "7d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["events-*"],
        "priority": 100
      }
    ]
  }
}
