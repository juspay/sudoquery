VITE_API_BASE_URL=http://localhost:3000/api

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=hyper-analytics
VITE_KEYCLOAK_CLIENT_ID=hyper-analytics-app
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback
VITE_KEYCLOAK_POST_LOGOUT_URI=http://localhost:5173
VITE_KEYCLOAK_IDP_ALIAS=your-email@example.com

# Analytics Configuration
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_FLUSH_INTERVAL=5000

VITE_MAINTENANCE_MODE=false

# Demo store at /demo, which sends events through clients/typescript to an
# events collector (run it with SERVER_ACCEPT_CORS=true). The route only exists
# when VITE_DEMO_ENABLED=true.
VITE_DEMO_ENABLED=false
VITE_DEMO_COLLECTOR_URL=http://localhost:3000/v1/events/batch
# Default organization ID (org_id) and project UUID (proj_id) to file events
# under. Optional: the page asks for them, and can use your current project.
VITE_DEMO_TENANT_ID=
VITE_DEMO_WORKSPACE_ID=
