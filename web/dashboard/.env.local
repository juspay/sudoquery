# Local overrides for the compose stack (gitignored). Vite loads this in
# every mode except `test`, including `vite build`.

# dashboard-server (DASHBOARD_BIND_ADDR default 0.0.0.0:3000, routes under /api)
VITE_API_BASE_URL=http://localhost:3000/api

# compose keycloak with the imported hyper-analytics realm
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=hyper-analytics
VITE_KEYCLOAK_CLIENT_ID=hyper-analytics-ui
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback
VITE_KEYCLOAK_POST_LOGOUT_URI=http://localhost:5173
# alias of the mock-Google IdP in the compose keycloak
VITE_KEYCLOAK_IDP_ALIAS=google

# Analytics posts to the hard-coded production endpoint (src/utils/analytics.ts);
# keep the token empty locally.
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_FLUSH_INTERVAL=5000

VITE_MAINTENANCE_MODE=false
